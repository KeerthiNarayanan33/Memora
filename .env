# MeetGuard AI — Environment Configuration
# Copy this file to .env and fill in the values

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/meetguard.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/meetguard

# ── Security ────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Ollama / Local LLM ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120

# ── Speech Processing ────────────────────────────────────────────────────────
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
# Options: tiny, base, small, medium, large-v2, large-v3

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_MODE=local
UPLOAD_DIR=./data/uploads
LOCAL_STORAGE_DIR=./data/local
MAX_UPLOAD_SIZE_MB=100

# ── Cloud Storage (optional) ────────────────────────────────────────────────
CLOUD_PROVIDER=none
# Options: none, s3, gcs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=MeetGuard AI
APP_ENV=development
# Options: development, production, demo
DEBUG=true
LOG_LEVEL=INFO

# ── Data Retention ───────────────────────────────────────────────────────────
RETENTION_DAYS=90

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Demo Mode ────────────────────────────────────────────────────────────────
DEMO_MODE=false
SEED_DEMO_DATA=true
